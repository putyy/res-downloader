{
  "id": "com.example.video",
  "name": "Example Video",
  "author": {
    "name": "Example Developer",
    "url": "https://example.com"
  },
  "version": "1.0.0",
  "apiVersion": 1,
  "runtime": "javascript",
  "entry": "main.js",
  "priority": 100,
  "permissions": {
    "domains": ["api.example.com"],
    "capabilities": ["observe-response", "read-response-body", "emit-resource"],
    "bodyLimit": 4194304
  },
  "match": [
    {"stage": "response", "host": "api.example.com", "path": "/api/videos/*", "contentTypes": ["application/json*"]}
  ],
  "resourceKinds": [{
    "id": "media.video",
    "icon": "video",
    "locales": {"zh": {"name": "视频"}, "en": {"name": "Video"}}
  }],
  "settingsSchema": {
    "type": "object",
    "properties": {
      "minimumSize": {"type": "number"}
    }
  }
}
