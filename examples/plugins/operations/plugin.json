{
  "id": "com.example.operations",
  "name": "Example Operations",
  "version": "1.0.0",
  "apiVersion": 1,
  "runtime": "javascript",
  "entry": "main.js",
  "permissions": {
    "domains": [
      "www.example.com"
    ],
    "capabilities": [
      "observe-response",
      "inject-page-script",
      "page-bridge",
      "capture-response-body",
      "emit-resource"
    ]
  },
  "match": [],
  "pageScripts": [
    {
      "id": "catalog",
      "entry": "page/controller.js",
      "match": [
        {
          "host": "www.example.com",
          "path": "/*"
        }
      ],
      "runAt": "document-start",
      "frames": "top",
      "bridge": true
    }
  ],
  "operations": {
    "search": {
      "name": "search",
      "category": "search",
      "pageScript": "catalog",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "query": {
            "type": "string",
            "maxLength": 64
          }
        },
        "required": [
          "query"
        ]
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "items": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string",
                  "maxLength": 256,
                  "x-persist": true
                },
                "pluginId": {
                  "type": "string",
                  "maxLength": 256
                },
                "kind": {
                  "type": "string",
                  "maxLength": 256
                },
                "title": {
                  "type": "string",
                  "maxLength": 256
                },
                "pageUrl": {
                  "type": "string",
                  "maxLength": 256
                },
                "capabilities": {
                  "type": "array",
                  "maxItems": 4,
                  "items": {
                    "type": "string",
                    "enum": [
                      "detail",
                      "resolve"
                    ]
                  }
                }
              },
              "required": [
                "id",
                "pluginId",
                "kind",
                "title",
                "pageUrl",
                "capabilities"
              ]
            }
          }
        },
        "required": [
          "items"
        ]
      },
      "effects": [
        "read"
      ],
      "cancellable": true,
      "safeRetry": true,
      "automation": true,
      "persistResult": true,
      "examples": [
        {
          "query": "example"
        }
      ]
    },
    "detail": {
      "name": "detail",
      "category": "detail",
      "pageScript": "catalog",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 256
          }
        },
        "required": [
          "id"
        ]
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 256,
            "x-persist": true
          },
          "pluginId": {
            "type": "string",
            "maxLength": 256
          },
          "kind": {
            "type": "string",
            "maxLength": 256
          },
          "title": {
            "type": "string",
            "maxLength": 256
          },
          "pageUrl": {
            "type": "string",
            "maxLength": 256
          },
          "capabilities": {
            "type": "array",
            "maxItems": 4,
            "items": {
              "type": "string",
              "enum": [
                "detail",
                "resolve"
              ]
            }
          }
        },
        "required": [
          "id",
          "pluginId",
          "kind",
          "title",
          "pageUrl",
          "capabilities"
        ]
      },
      "effects": [
        "read"
      ],
      "cancellable": true,
      "safeRetry": true,
      "automation": true,
      "persistResult": false,
      "examples": [
        {
          "id": "note-1"
        }
      ]
    },
    "resolve": {
      "name": "resolve",
      "category": "resolve",
      "pageScript": "catalog",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 256
          }
        },
        "required": [
          "id"
        ]
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 256
          },
          "title": {
            "type": "string",
            "maxLength": 256
          },
          "text": {
            "type": "string",
            "maxLength": 4096
          }
        },
        "required": [
          "id",
          "title",
          "text"
        ]
      },
      "effects": [
        "read",
        "publish"
      ],
      "cancellable": true,
      "safeRetry": false,
      "automation": true,
      "persistResult": false,
      "examples": [
        {
          "id": "note-1"
        }
      ]
    },
    "text": {
      "name": "text",
      "category": "text",
      "pageScript": "catalog",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 256
          }
        },
        "required": [
          "id"
        ]
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 256
          },
          "title": {
            "type": "string",
            "maxLength": 256
          },
          "text": {
            "type": "string",
            "maxLength": 4096
          }
        },
        "required": [
          "id",
          "title",
          "text"
        ]
      },
      "effects": [
        "read",
        "publish"
      ],
      "cancellable": true,
      "safeRetry": false,
      "automation": true,
      "persistResult": false,
      "examples": [
        {
          "id": "note-1"
        }
      ]
    }
  },
  "settingsSchema": {
    "type": "object",
    "properties": {
      "enableLog": {
        "type": "boolean",
        "default": false,
        "x-locales": {
          "zh": {
            "name": "调试日志"
          },
          "en": {
            "name": "Debug logging"
          }
        }
      }
    }
  }
}
